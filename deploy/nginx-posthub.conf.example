# Optional PUBLIC-server configuration; Wensi Postman itself does not require Nginx.
# This example assumes Nginx and frps are on the same public server.
# Replace the domain and certificate paths, then run nginx -t before reloading.
server {
    listen 443 ssl;
    server_name notify.example.com;
    ssl_certificate /path/to/notify.example.com/fullchain.pem;
    ssl_certificate_key /path/to/notify.example.com/privkey.pem;

    # Dedicated hook URLs contain credentials; do not record full request URLs.
    access_log off;
    client_max_body_size 64k;

    location / {
        proxy_pass http://127.0.0.1:18087;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }
}
